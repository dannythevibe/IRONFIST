{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ironfist",
  // Theobsidianstudios0 Cloudflare account. Change this to deploy elsewhere.
  "account_id": "730f4300ada352c5cc0d09bae58f6729",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // The console is a static Next.js export. Build it first: `npm run build` in ../web-portal
  "assets": {
    "directory": "../web-portal/out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/v1/*", "/api/*", "/mcp", "/health"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ironfist",
      "database_id": "38c76351-dec1-4550-9b1c-b51f54a1efce",
      "migrations_dir": "migrations"
    }
  ],

  "durable_objects": {
    "bindings": [{ "name": "BUCKETS", "class_name": "TokenBucket" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TokenBucket"] }],

  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true }
}
